<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="main">
        <category id="backend" label="30010" help="">
            <group id="1" label="30011">
                <setting id="backend_url" type="string" label="30020" help="30021">
                    <level>0</level>
                    <default>127.0.0.1</default>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="backend_port" type="integer" label="30030" help="30031">
                    <level>0</level>
                    <default>7777</default>
                    <constraints>
                        <minimum>1</minimum>
                        <maximum>65535</maximum>
                    </constraints>
                    <control type="spinner" format="integer"/>
                </setting>
            </group>
            <group id="2" label="30012">
                <setting id="retry_attempts" type="integer" label="30040" help="30041">
                    <level>1</level>
                    <default>10</default>
                    <constraints>
                        <minimum>1</minimum>
                        <maximum>30</maximum>
                    </constraints>
                    <control type="spinner" format="integer"/>
                </setting>
                <setting id="retry_delay" type="integer" label="30050" help="30051">
                    <level>1</level>
                    <default>2000</default>
                    <constraints>
                        <minimum>100</minimum>
                        <maximum>10000</maximum>
                        <step>100</step>
                    </constraints>
                    <control type="spinner" format="integer"/>
                </setting>
            </group>
        </category>

        <!-- EPG: three modes. Off = no EPG at all (no fetches, not recordable,
             not playable/catchup from EPG). Backend = the provider API (default,
             same behaviour as the old "epg_enabled=false"). External = a separate
             EPG service, with fallback to the backend. -->
        <category id="epg" label="30064" help="">
            <group id="3" label="30065">
                <setting id="epg_mode" type="integer" label="30060" help="30061">
                    <level>0</level>
                    <default>1</default>
                    <constraints>
                        <options>
                            <option label="30066">0</option>
                            <option label="30067">1</option>
                            <option label="30068">2</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
                <setting id="epg_service_url" type="string" label="30062" help="30063">
                    <level>0</level>
                    <default>http://localhost:8080</default>
                    <enable>eq(epg_mode,2)</enable>
                    <control type="edit" format="string"/>
                </setting>
                <!-- Legacy, hidden. Kept only so the old value stays readable for the
                     one-time migration epg_enabled=true -> epg_mode=2. Reset to false
                     by the addon after migrating. Safe to remove in a later release. -->
                <setting id="epg_enabled" type="boolean" label="30060" help="">
                    <level>0</level>
                    <default>false</default>
                    <visible>false</visible>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

        <!-- Provider selection: acts like a button. Toggle on + confirm with OK opens the dialog. -->
        <category id="providers" label="30923" help="">
            <group id="4" label="30924">
                <setting id="provider_selection" type="boolean" label="30925" help="30926">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
    </section>
</settings>