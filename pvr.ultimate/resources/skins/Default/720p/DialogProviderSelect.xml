<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
  <defaultcontrol always="true">50</defaultcontrol>
  <!-- REQUIRED: Kodi only attaches list items (AddListItem) to containers named here -->
  <views>50</views>
  <animation effect="fade" time="150">WindowOpen</animation>
  <animation effect="fade" time="120">WindowClose</animation>
  <controls>

    <!-- dim background -->
    <control type="image">
      <left>0</left><top>0</top><width>1280</width><height>720</height>
      <texture colordiffuse="C8000000">white.png</texture>
    </control>

    <control type="group">
      <left>190</left>
      <top>50</top>

      <!-- panel -->
      <control type="image">
        <left>0</left><top>0</top><width>900</width><height>620</height>
        <texture colordiffuse="FF2E9BFF">white.png</texture>
      </control>
      <control type="image">
        <left>2</left><top>2</top><width>896</width><height>616</height>
        <texture colordiffuse="FF171A21">white.png</texture>
      </control>

      <!-- header -->
      <control type="image">
        <left>2</left><top>2</top><width>896</width><height>70</height>
        <texture colordiffuse="FF1F2430">white.png</texture>
      </control>
      <control type="image">
        <left>2</left><top>70</top><width>896</width><height>2</height>
        <texture colordiffuse="FF2E9BFF">white.png</texture>
      </control>
      <control type="label" id="10">
        <left>30</left><top>2</top><width>840</width><height>70</height>
        <font>font14</font>
        <textcolor>FFFFFFFF</textcolor>
        <aligny>center</aligny>
        <label>$ADDON[pvr.ultimate 30919]</label>
      </control>

      <!-- provider list -->
      <control type="list" id="50">
        <left>10</left>
        <top>82</top>
        <width>866</width>
        <height>440</height>
        <onup>50</onup>
        <ondown>201</ondown>
        <onleft>50</onleft>
        <onright>60</onright>
        <scrolltime>150</scrolltime>
        <orientation>vertical</orientation>
        <pagecontrol>60</pagecontrol>

        <itemlayout height="80">
          <control type="image">
            <left>0</left><top>78</top><width>866</width><height>1</height>
            <texture colordiffuse="22FFFFFF">white.png</texture>
          </control>
          <!-- checkbox -->
          <control type="image">
            <left>16</left><top>22</top><width>36</width><height>36</height>
            <texture>check_on.png</texture>
            <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="image">
            <left>16</left><top>22</top><width>36</width><height>36</height>
            <texture>check_off.png</texture>
            <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <!-- logo tile -->
          <control type="image">
            <left>72</left><top>10</top><width>110</width><height>60</height>
            <texture colordiffuse="30FFFFFF">white.png</texture>
          </control>
          <control type="image">
            <left>78</left><top>14</top><width>98</width><height>52</height>
            <aspectratio>keep</aspectratio>
            <texture fallback="provider_default.png">$INFO[ListItem.Icon]</texture>
            <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="image">
            <left>78</left><top>14</top><width>98</width><height>52</height>
            <aspectratio>keep</aspectratio>
            <colordiffuse>60FFFFFF</colordiffuse>
            <texture fallback="provider_default.png">$INFO[ListItem.Icon]</texture>
            <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <!-- texts -->
          <control type="label">
            <left>202</left><top>12</top><width>520</width><height>30</height>
            <font>font13</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="label">
            <left>202</left><top>12</top><width>520</width><height>30</height>
            <font>font13</font>
            <textcolor>66FFFFFF</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="label">
            <left>202</left><top>44</top><width>520</width><height>24</height>
            <font>font12</font>
            <textcolor>FF9AA4B5</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
          <!-- on/off pill -->
          <control type="label">
            <left>700</left><top>0</top><width>150</width><height>78</height>
            <font>font12</font>
            <align>right</align>
            <aligny>center</aligny>
            <textcolor>FF4CD28A</textcolor>
            <label>$ADDON[pvr.ultimate 30913]</label>
            <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="label">
            <left>700</left><top>0</top><width>150</width><height>78</height>
            <font>font12</font>
            <align>right</align>
            <aligny>center</aligny>
            <textcolor>66FFFFFF</textcolor>
            <label>$ADDON[pvr.ultimate 30914]</label>
            <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
        </itemlayout>

        <focusedlayout height="80">
          <control type="image">
            <left>0</left><top>0</top><width>866</width><height>79</height>
            <texture colordiffuse="FF2E9BFF">white.png</texture>
            <visible>Control.HasFocus(50)</visible>
          </control>
          <control type="image">
            <left>0</left><top>0</top><width>866</width><height>79</height>
            <texture colordiffuse="402E9BFF">white.png</texture>
            <visible>!Control.HasFocus(50)</visible>
          </control>
          <control type="image">
            <left>16</left><top>22</top><width>36</width><height>36</height>
            <texture>check_on.png</texture>
            <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="image">
            <left>16</left><top>22</top><width>36</width><height>36</height>
            <texture>check_off.png</texture>
            <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="image">
            <left>72</left><top>10</top><width>110</width><height>60</height>
            <texture colordiffuse="40FFFFFF">white.png</texture>
          </control>
          <control type="image">
            <left>78</left><top>14</top><width>98</width><height>52</height>
            <aspectratio>keep</aspectratio>
            <texture fallback="provider_default.png">$INFO[ListItem.Icon]</texture>
          </control>
          <control type="label">
            <left>202</left><top>12</top><width>520</width><height>30</height>
            <font>font13</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
          <control type="label">
            <left>202</left><top>44</top><width>520</width><height>24</height>
            <font>font12</font>
            <textcolor>FFDCE6F5</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
          <control type="label">
            <left>700</left><top>0</top><width>150</width><height>78</height>
            <font>font12</font>
            <align>right</align>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <label>$ADDON[pvr.ultimate 30913]</label>
            <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
          <control type="label">
            <left>700</left><top>0</top><width>150</width><height>78</height>
            <font>font12</font>
            <align>right</align>
            <aligny>center</aligny>
            <textcolor>AAFFFFFF</textcolor>
            <label>$ADDON[pvr.ultimate 30914]</label>
            <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
          </control>
        </focusedlayout>
      </control>

      <control type="scrollbar" id="60">
        <left>884</left>
        <top>86</top>
        <width>8</width>
        <height>432</height>
        <texturesliderbackground colordiffuse="20FFFFFF">white.png</texturesliderbackground>
        <texturesliderbar colordiffuse="60FFFFFF">white.png</texturesliderbar>
        <texturesliderbarfocus colordiffuse="FF2E9BFF">white.png</texturesliderbarfocus>
        <orientation>vertical</orientation>
        <showonepage>false</showonepage>
        <onleft>50</onleft>
        <onup>50</onup>
        <ondown>201</ondown>
      </control>

      <!-- footer -->
      <control type="image">
        <left>2</left><top>536</top><width>896</width><height>1</height>
        <texture colordiffuse="30FFFFFF">white.png</texture>
      </control>
      <control type="label" id="11">
        <left>30</left><top>546</top><width>230</width><height>66</height>
        <font>font12</font>
        <textcolor>FF9AA4B5</textcolor>
        <aligny>center</aligny>
      </control>

      <control type="button" id="201">
        <left>270</left><top>555</top><width>150</width><height>48</height>
        <label>$ADDON[pvr.ultimate 30901]</label>
        <font>font12</font>
        <align>center</align><aligny>center</aligny>
        <textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturenofocus colordiffuse="FF2A303D">white.png</texturenofocus>
        <texturefocus colordiffuse="FF2E9BFF">white.png</texturefocus>
        <onleft>201</onleft><onright>202</onright><onup>50</onup><ondown>201</ondown>
      </control>
      <control type="button" id="202">
        <left>430</left><top>555</top><width>150</width><height>48</height>
        <label>$ADDON[pvr.ultimate 30902]</label>
        <font>font12</font>
        <align>center</align><aligny>center</aligny>
        <textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturenofocus colordiffuse="FF2A303D">white.png</texturenofocus>
        <texturefocus colordiffuse="FF2E9BFF">white.png</texturefocus>
        <onleft>201</onleft><onright>203</onright><onup>50</onup><ondown>202</ondown>
      </control>
      <control type="button" id="203">
        <left>600</left><top>555</top><width>140</width><height>48</height>
        <label>$ADDON[pvr.ultimate 30903]</label>
        <font>font12</font>
        <align>center</align><aligny>center</aligny>
        <textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturenofocus colordiffuse="FF1F8F5A">white.png</texturenofocus>
        <texturefocus colordiffuse="FF2BC27A">white.png</texturefocus>
        <onleft>202</onleft><onright>204</onright><onup>50</onup><ondown>203</ondown>
      </control>
      <control type="button" id="204">
        <left>750</left><top>555</top><width>130</width><height>48</height>
        <label>$ADDON[pvr.ultimate 30904]</label>
        <font>font12</font>
        <align>center</align><aligny>center</aligny>
        <textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturenofocus colordiffuse="FF2A303D">white.png</texturenofocus>
        <texturefocus colordiffuse="FF2E9BFF">white.png</texturefocus>
        <onleft>203</onleft><onright>204</onright><onup>50</onup><ondown>204</ondown>
      </control>
    </control>
  </controls>
</window>
